# Copy to a local .env only when your deployment process loads it.
# Keep real credentials outside source control and inject them on the target machine.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
KNOWLEDGE_SEARCH_PROVIDER=
KNOWLEDGE_SEARCH_API_URL=
KNOWLEDGE_SEARCH_API_KEY=

# Optional: omit this to use PROCESSMIND_DATA_DIR/db/process_mind.db.
# This build supports SQLite through the async aiosqlite driver only.
# DATABASE_URL=sqlite+aiosqlite:///absolute/path/to/process_mind.db

# Maximum number of KmAI DNF rule combinations produced by one export.
PROCESSMIND_KMAI_MAX_COMBINATIONS=10000

# Maximum total number of condition objects across expanded KmAI DNF clauses.
PROCESSMIND_KMAI_MAX_CONDITION_OBJECTS=100000
