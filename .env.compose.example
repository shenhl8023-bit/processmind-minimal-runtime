PROCESSMIND_API_IMAGE=registry.cn-hangzhou.aliyuncs.com/public-topeak/processmind-api:20260327
PROCESSMIND_WEB_IMAGE=registry.cn-hangzhou.aliyuncs.com/public-topeak/processmind-web:20260327
PROCESSMIND_WEB_PORT=8080

LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
RULE_CONDITION_LLM_TIMEOUT_SECONDS=45
RULE_CONDITION_LLM_MAX_RETRIES=1

# This build supports SQLite through the async aiosqlite driver only.
DATABASE_URL=sqlite+aiosqlite:////runtime-data/db/process_mind.db

KNOWLEDGE_SEARCH_PROVIDER=
KNOWLEDGE_SEARCH_API_URL=
KNOWLEDGE_SEARCH_API_KEY=

PROCESSMIND_KMAI_MAX_COMBINATIONS=10000
PROCESSMIND_KMAI_MAX_CONDITION_OBJECTS=100000

INCLUDE_ROLLER_PROFILE_ASSETS=0
