    {
      "id": "P028",
      "type": "paragraph",
      "style": null,
      "text": "3  典型零件工艺规程设计"
    },
    {
      "id": "P029",
      "type": "paragraph",
      "style": null,
      "text": "3.1 工艺路线如下："
    },
    {
      "id": "P030",
